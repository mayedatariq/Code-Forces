#include <iostream>
using namespace std;
 
int main()
{
    int a, b, c, d, shoeCnt = 0;
    cin >> a >> b;
    if (b == a)
    {
        shoeCnt++;
    }
    cin >> c;
    if (c == b || c == a)
    {
        shoeCnt++;
    }
    cin >> d;
    if (d == c || d == b || d == a)
    {
        shoeCnt++;
    }
    cout << shoeCnt;
    
    
    return 0;
}