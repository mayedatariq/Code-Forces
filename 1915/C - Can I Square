#include <iostream>
#include <cmath>
using namespace std;
 
int main()
{
    unsigned long long int t, n, a, sum;
    cin >> t;
    for (unsigned long long int i = 1; i <= t; i++)
    {
        cin >> n;
        sum = 0;
        for (unsigned long long int j = 1; j <= n; j++)
        {
            cin >> a;
            sum = sum + a;
        }
        if ((sqrt(sum) - (int)sqrt(sum) == 0))
        {
            cout << "YES
";
        }
        else
        {
            cout << "NO
";
        }
    }
    
    return 0;
}