#include <iostream>
#include <string>
using namespace std;
 
int main()
{
    int t, n;
    string str;
    cin >> t;
    for (int i = 1; i <= t; i++)
    {
        cin >> n;
        cin >> str;
        int j = 0;
        if (j < n && !(str[j] == 'm' || str[j] == 'M'))
        {
            cout << "NO" << endl;
        }
        else
        {
            j++;
            while(j < n && (str[j] == 'm' || str[j] == 'M'))
            {
                j++;
            }
            if (j < n && !(str[j] == 'e' || str[j] == 'E'))
            {
                cout << "NO" << endl;
            }
            else
            {
                j++;
                while(j < n && (str[j] == 'e' || str[j] == 'E'))
                {
                    j++;
                }
                if (j < n && !(str[j] == 'o' || str[j] == 'O'))
                {
                    cout << "NO" << endl;
                }
                else
                {
                    j++;
                    while(j < n && (str[j] == 'o' || str[j] == 'O'))
                    {
                        j++;
                    }
                    if (j < n && !(str[j] == 'w' || str[j] == 'W'))
                    {
                        cout << "NO" << endl;
                    }
                    else
                    {
                        j++;
                        while(j < n && (str[j] == 'w' || str[j] == 'W'))
                        {
                            j++;
                        }
                        if (j == n)
                        {
                            cout << "YES" << endl;
                        }
                        else
                        {
                            cout << "NO" << endl;
                        }
                    }
                }
            
            }
            
        }
    }
 
    return 0;
}