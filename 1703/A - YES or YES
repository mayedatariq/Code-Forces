#include <iostream>
using namespace std; 
 
bool isYes (char p[])
{
    if (p[0] != 'y' && p[0] != 'Y')
    {
        return false;
    }
    if (p[1] != 'e' && p[1] != 'E')
    {
        return false;
    }
    if (p[2] != 's' && p[2] != 'S')
    {
        return false;
    }
    return true;
}
 
int main()
{
    int n;
    char p[3];
    cin >> n;
    
    for (int i = 1; i <= n; i = i + 1)
    {
        for (int j = 0; j < 3; j = j + 1)
        {
            cin >> p[j];
        }
        cout << (isYes(p) ? "YES
" : "NO
");
    }
    
    return 0;
}